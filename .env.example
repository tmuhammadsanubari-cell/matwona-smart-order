# ===== Salin ke .env (root). apps/api & apps/reco membaca file ini. =====

# ---------- apps/api ----------
APP_NAME=matwona-smart-order-api
APP_PORT=4000
APP_ENV=development
APP_TIMEZONE=Asia/Jakarta
WEB_ORIGIN=http://localhost:3000
# Alamat web yang dicetak di QR meja (PDF). Kosong = origin pertama WEB_ORIGIN.
# Uji scan QR cetak dari HP lewat hotspot laptop: http://192.168.137.1:3000
PUBLIC_WEB_URL=

DATABASE_URL=postgresql://matwona:matwona@localhost:5432/matwona_smart_order
REDIS_URL=redis://localhost:6379

JWT_ACCESS_SECRET=ganti-dengan-string-acak-64-karakter
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=ganti-dengan-string-acak-64-karakter-lain
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_COST=12
# Kosong = otomatis true saat NODE_ENV=production. Isi "true"/"false" untuk memaksa (lokal http: false).
COOKIE_SECURE=
# Kosong = cookie hanya untuk host API. Isi domain induk (mis. .matwona.id) bila web & API beda subdomain.
COOKIE_DOMAIN=

MIDTRANS_IS_PRODUCTION=false
MIDTRANS_SERVER_KEY=SB-Mid-server-xxxxxxxx
MIDTRANS_CLIENT_KEY=SB-Mid-client-xxxxxxxx
QRIS_EXPIRY_MINUTES=15

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# olsera-csv | olsera-api | mock
POS_SYNC_ADAPTER=olsera-csv
OLSERA_API_BASE_URL=
OLSERA_API_KEY=

RECO_SERVICE_URL=http://localhost:8000
RECO_INTERNAL_KEY=ganti-dengan-string-acak
RECO_TIMEOUT_MS=300

ORDER_RATE_LIMIT_MAX=5
ORDER_RATE_LIMIT_WINDOW_SEC=600
# Jumlah proxy di depan API (Cloud Run = 1) agar rate limit per IP membaca IP klien asli (NFR-009).
TRUST_PROXY_HOPS=1

SENTRY_DSN=

# ---------- apps/reco ----------
RECO_DATABASE_URL=postgresql+psycopg://matwona:matwona@localhost:5432/matwona_smart_order
RECO_MIN_SUPPORT=0.01
RECO_MIN_CONFIDENCE=0.2
RECO_MIN_LIFT=1.0
RECO_TRAINING_WINDOW_DAYS=180
RECO_HOLDOUT_RATIO=0.2

# ---------- apps/web (juga set di Vercel) ----------
NEXT_PUBLIC_API_URL=http://localhost:4000/api
NEXT_PUBLIC_SOCKET_URL=http://localhost:4000/realtime
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=SB-Mid-client-xxxxxxxx
NEXT_PUBLIC_MIDTRANS_SNAP_URL=https://app.sandbox.midtrans.com/snap/snap.js
NEXT_PUBLIC_OUTLET_SLUG=matwona
NEXT_PUBLIC_GMAPS_EMBED_URL=
